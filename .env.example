# Copy to .env for local Compose only; never commit real secrets.
MYSQL_ROOT_PASSWD=
MYSQL_UNICHATGO_PASSWD=
REDIS_PASSWD=
# 32 random bytes encoded as standard base64.
UNICHATGO_APIKEY_KEY=
ADMIN_TOKEN=

UNICHATGO_DB=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=unichatgo
MYSQL_DATABASE=unichatgo
MYSQL_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Local Redis is plaintext; set true for TLS-enabled ElastiCache in AWS.
REDIS_TLS=false
AUTH_MODE=local
# Local HTTP requires debug; cloud HTTPS must use release.
GIN_MODE=debug
SERVER_ADDRESS=:8090
TRUSTED_PROXY_CIDRS=

# Required only for AUTH_MODE=cognito; dev/prod must use different clients.
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:8090/api/auth/callback
FRONTEND_URL=http://localhost:5173

# v2 agent: platform model, BYOK, credits and uploads.
LLM_KIND=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional reasoning_effort for the platform model (e.g. none). If unset and the
# model rejects tools with reasoning, the adapter retries once with "none".
LLM_REASONING_EFFORT=
# Development only: allow BYOK over http and loopback (for example Ollama).
LLM_ALLOW_INSECURE_BYOK=false
ASSISTANT_RPM=5
CREDITS_DAILY_GRANT=100
CREDITS_COST_CHAT=1
CREDITS_COST_TOOL=2
CREDITS_COST_VISION=5
AGENT_MAX_STEPS=6
AGENT_DRAFT_TTL_MINUTES=30
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
UPLOAD_TTL_HOURS=24
S3_BUCKET=
S3_REGION=
S3_PREFIX=uploads/
# v1-only variables removed in 2.0: ASSISTANT_DAILY_LIMIT and
# LEGACY_UPLOADS_ENABLED. Use CREDITS_* and the private upload settings above.
VITE_API_BASE_URL=/api
VITE_AUTH_MODE=local
VITE_USE_MOCK=false
