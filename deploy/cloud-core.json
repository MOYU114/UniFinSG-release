{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "UniFinSG prod: real managed database/cache, private CloudFront origin and private uploads. No NAT gateway.",
  "Parameters": {
    "CloudFrontPrefixList": {
      "Type": "String",
      "Default": "pl-31a34658"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.42.0.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "PublicARoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicA"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PrivateA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.42.10.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "PublicB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.42.1.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "PublicBRoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicB"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PrivateB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.42.11.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private CloudFront origin",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "AppSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Backend tasks",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "DatabaseSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private MySQL",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "RedisSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private TLS Redis",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "CloudFrontIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "AlbSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 80,
        "ToPort": 80,
        "SourcePrefixListId": {
          "Ref": "CloudFrontPrefixList"
        }
      }
    },
    "AppIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "AppSecurity"
        },
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8090,
        "ToPort": 8090
      }
    },
    "DatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurity"
        },
        "SourceSecurityGroupId": {
          "Ref": "AppSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306
      }
    },
    "RedisIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "RedisSecurity"
        },
        "SourceSecurityGroupId": {
          "Ref": "AppSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 6379,
        "ToPort": 6379
      }
    },
    "AdminPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true,
          "SecretStringTemplate": "{\"username\": \"dbadmin\"}",
          "GenerateStringKey": "password"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "DatabasePassword": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true,
          "SecretStringTemplate": "{\"username\": \"unichatgo\"}",
          "GenerateStringKey": "password"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "RedisPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "ApplicationKey": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "AdminToken": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "UniFinSG private database",
        "SubnetIds": [
          {
            "Ref": "PrivateA"
          },
          {
            "Ref": "PrivateB"
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceIdentifier": "unifinsg-prod-mysql",
        "Engine": "mysql",
        "EngineVersion": "8.4.13",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "unichatgo",
        "MasterUsername": "dbadmin",
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${AdminPassword}:SecretString:password}}"
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurity"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "BackupRetentionPeriod": 1,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "CopyTagsToSnapshot": true,
        "EngineLifecycleSupport": "open-source-rds-extended-support-disabled",
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "RedisSubnets": {
      "Type": "AWS::ElastiCache::SubnetGroup",
      "Properties": {
        "Description": "UniFinSG private cache",
        "SubnetIds": [
          {
            "Ref": "PrivateA"
          },
          {
            "Ref": "PrivateB"
          }
        ]
      }
    },
    "Redis": {
      "Type": "AWS::ElastiCache::ReplicationGroup",
      "Properties": {
        "ReplicationGroupId": "unifinsg-prod-redis",
        "ReplicationGroupDescription": "UniFinSG TLS session and credits store",
        "Engine": "redis",
        "EngineVersion": "7.1",
        "CacheNodeType": "cache.t4g.micro",
        "NumCacheClusters": 1,
        "AutomaticFailoverEnabled": false,
        "CacheSubnetGroupName": {
          "Ref": "RedisSubnets"
        },
        "SecurityGroupIds": [
          {
            "Ref": "RedisSecurity"
          }
        ],
        "AtRestEncryptionEnabled": true,
        "TransitEncryptionEnabled": true,
        "AuthToken": {
          "Fn::Sub": "{{resolve:secretsmanager:${RedisPassword}:SecretString}}"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "FrontendBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "unifinsg-prod-frontend-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ],
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "old-frontend-versions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "UploadBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "unifinsg-prod-uploads-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ],
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-private-images",
              "Status": "Enabled",
              "Prefix": "uploads/",
              "ExpirationInDays": 1,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "unifinsg-prod",
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "disabled"
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/unifinsg/prod/backend",
        "RetentionInDays": 7,
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "unifinsg-prod",
        "Scheme": "internal",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "PrivateA"
          },
          {
            "Ref": "PrivateB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSecurity"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "180"
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "unifinsg-prod-backend",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Protocol": "HTTP",
        "Port": 8090,
        "TargetType": "ip",
        "HealthCheckPath": "/readyz",
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Name": "unifinsg-prod-api",
          "Arn": {
            "Ref": "Alb"
          },
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only"
        }
      },
      "DependsOn": [
        "Listener",
        "GatewayAttachment"
      ]
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": "unifinsg-prod-frontend",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SpaFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": "unifinsg-prod-spa",
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Only rewrite SPA routes on the S3 origin",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "// Associate ONLY with the default S3 cache behavior (viewer-request).\n// Never globally replace API 403/404 responses with index.html.\nfunction handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  if (uri === '/api' || uri.indexOf('/api/') === 0) return request;\n  if (uri.endsWith('/') || uri.split('/').pop().indexOf('.') === -1) {\n    request.uri = '/index.html';\n  }\n  return request;\n}\n"
      }
    },
    "ApiOriginPolicy": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": "unifinsg-prod-api",
          "CookiesConfig": {
            "CookieBehavior": "all"
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "all"
          },
          "HeadersConfig": {
            "HeaderBehavior": "allExcept",
            "Headers": [
              "host"
            ]
          }
        }
      }
    },
    "ApiCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": "unifinsg-prod-api-no-cache",
          "MinTTL": 0,
          "DefaultTTL": 0,
          "MaxTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            },
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false
          }
        }
      }
    },
    "FrontendCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": "unifinsg-prod-static",
          "MinTTL": 0,
          "DefaultTTL": 3600,
          "MaxTTL": 31536000,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            },
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "UniFinSG prod",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_All",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "frontend",
              "DomainName": {
                "Fn::GetAtt": [
                  "FrontendBucket",
                  "RegionalDomainName"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              }
            },
            {
              "Id": "api",
              "DomainName": {
                "Fn::GetAtt": [
                  "Alb",
                  "DNSName"
                ]
              },
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "VpcOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 60,
                "OriginKeepaliveTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "frontend",
            "ViewerProtocolPolicy": "redirect-to-https",
            "Compress": true,
            "CachePolicyId": {
              "Ref": "FrontendCachePolicy"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SpaFunction",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/*",
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "POST",
                "PATCH",
                "DELETE"
              ],
              "CachePolicyId": {
                "Ref": "ApiCachePolicy"
              },
              "OriginRequestPolicyId": {
                "Ref": "ApiOriginPolicy"
              },
              "Compress": false
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "FrontendPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "FrontendBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${FrontendBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "FrontendBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${FrontendBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "UploadPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "UploadBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "UploadBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${UploadBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": "unifinsg-prod",
        "UserPoolTier": "LITE",
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 10,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "UserPoolTags": {
          "project": "unifinsg",
          "environment": "prod"
        }
      }
    },
    "UserPoolDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {
          "Fn::Sub": "unifinsg-prod-${AWS::AccountId}"
        },
        "UserPoolId": {
          "Ref": "UserPool"
        }
      }
    },
    "UserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "ClientName": "unifinsg-prod-web",
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "GenerateSecret": true,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "email"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}/api/auth/callback"
          }
        ],
        "LogoutURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}"
          }
        ],
        "ExplicitAuthFlows": [
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "EnableTokenRevocation": true,
        "PreventUserExistenceErrors": "ENABLED",
        "ReadAttributes": [
          "email",
          "email_verified"
        ],
        "WriteAttributes": [
          "email"
        ]
      }
    },
    "CognitoSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "PlatformModel": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "SecretString": "{\"kind\": \"openai_compatible\", \"base_url\": \"\", \"model\": \"\", \"api_key\": \"\"}",
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "project-resources",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/unifinsg-prod-backend"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Ref": "AdminPassword"
                    },
                    {
                      "Ref": "DatabasePassword"
                    },
                    {
                      "Ref": "RedisPassword"
                    },
                    {
                      "Ref": "ApplicationKey"
                    },
                    {
                      "Ref": "AdminToken"
                    },
                    {
                      "Ref": "CognitoSecret"
                    },
                    {
                      "Ref": "PlatformModel"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "project-resources",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${UploadBucket.Arn}/uploads/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cognito-idp:AdminDeleteUser",
                  "Resource": {
                    "Fn::GetAtt": [
                      "UserPool",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    }
  },
