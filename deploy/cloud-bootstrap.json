{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "UniFinSG image build bootstrap: ECR and narrowly scoped GitHub OIDC",
  "Resources": {
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "unifinsg-prod-backend",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Expire untagged images\",\"selection\":{\"tagStatus\":\"untagged\",\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"countNumber\":7},\"action\":{\"type\":\"expire\"}}]}"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    },
    "GitHubOIDC": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "ImageBuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "unifinsg-prod-image-build",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOIDC"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": [
                    "repo:MOYU114@92241694/UniFinSG@1389280858:ref:refs/heads/ops_cloud_dev",
                    "repo:MOYU114@92241694/UniFinSG@1389280858:ref:refs/heads/main"
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "push-project-image-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Repository",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "unifinsg"
          },
          {
            "Key": "environment",
            "Value": "prod"
          }
        ]
      }
    }
  },
  "Outputs": {
    "RepositoryURI": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "ImageBuildRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ImageBuildRole",
          "Arn"
        ]
      }
    }
  }
}
